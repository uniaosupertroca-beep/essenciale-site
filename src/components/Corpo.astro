---
// Tratamentos para o corpo, com a ideia que a clínica repete no Instagram: a tecnologia alcança
// camadas que o treino e a dieta não alcançam.
import { porCategoria } from "../data/tratamentos.ts";
import CartaoTratamento from "./CartaoTratamento.astro";
---

<section class="secao nude" id="corpo" aria-labelledby="t-corpo">
  <div class="envolve">
    <div class="cabeca">
      <div>
        <p class="chapeu">Corpo · sem cirurgia</p>
        <h2 class="titulo" id="t-corpo">Onde o treino não alcança, <em>a tecnologia ajuda.</em></h2>
      </div>
      <p class="abre">
        Depois dos 40, a gordura se acumula com mais facilidade e a pele perde firmeza. Músculos fortes também não garantem definição. Os
        protocolos para o corpo agem em camadas que o exercício e a dieta não alcançam, sem cortes e, em geral, sem afastar você da rotina.
      </p>
    </div>
    <ul class="grade">
      {
        porCategoria("Corpo").map((t) => (
          <li>
            <CartaoTratamento nome={t.nome} resumo={t.resumo} href={`/tratamentos/${t.slug}/`} icone={t.icone} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cabeca {
    display: grid;
    gap: 8px 72px;
    align-items: end;
  }
  @media (min-width: 960px) {
    .cabeca {
      grid-template-columns: 1.1fr 0.9fr;
    }
    .cabeca .abre {
      margin-top: 0;
    }
  }
  .grade {
    list-style: none;
    padding: 0;
    margin-top: clamp(48px, 6vw, 72px);
    display: grid;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .grade {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1080px) {
    .grade {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .grade li {
    display: grid;
  }
</style>
