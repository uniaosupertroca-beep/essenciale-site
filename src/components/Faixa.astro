---
// Faixa que corre entre a abertura e o conteúdo, com os nomes dos tratamentos.
// É decorativa (repete o que a página já diz), então fica fora da leitura de tela.
import { tratamentos } from "../data/tratamentos.ts";
import Icone from "./Icone.astro";

const volta = [...tratamentos.map((t) => t.nome), ...tratamentos.map((t) => t.nome)];
---

<div class="faixa" aria-hidden="true">
  <div class="trilho">
    {
      [0, 1].map(() => (
        <ul>
          {volta.map((p) => (
            <li>
              <span>{p}</span>
              <Icone nome="brilho" tamanho={14} traco={1.3} />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .faixa {
    background: var(--ameixa);
    overflow: hidden;
    color: var(--dourado);
  }
  .trilho {
    display: flex;
    width: max-content;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }
  li {
    display: flex;
    align-items: center;
    gap: 36px;
    padding: 18px 0 18px 36px;
    white-space: nowrap;
  }
  span {
    font-family: var(--serifa);
    font-style: italic;
    font-size: 22px;
    font-weight: 400;
    color: var(--rose-claro);
  }
  @media (prefers-reduced-motion: no-preference) {
    .trilho {
      animation: corre 70s linear infinite;
    }
  }
  @keyframes corre {
    to {
      transform: translateX(-50%);
    }
  }
</style>
