---
// Respostas honestas: sem promessa de resultado, sem preço e sem "risco zero"
// (Código de Defesa do Consumidor, art. 37, e regras de publicidade dos conselhos de saúde).
import { linkWhatsapp } from "../data/clinica.ts";
import Icone from "./Icone.astro";

interface Props {
  perguntas?: { p: string; r: string }[];
  titulo?: string;
  destaque?: string;
  /** Mensagem pronta do botão do WhatsApp. */
  mensagem?: string;
}

const padrao = [
  {
    p: "Os tratamentos têm cirurgia ou cortes?",
    r: "Não. Os protocolos são feitos na clínica, com tecnologias e técnicas não cirúrgicas, sem cortes e sem internação.",
  },
  {
    p: "Preciso parar a minha rotina?",
    r: "Na maioria dos protocolos, não: dá para voltar às atividades no mesmo dia. Quando algum cuidado é necessário, ele é explicado antes de começar.",
  },
  {
    p: "Os tratamentos doem?",
    r: "A maioria é bem tolerada. Algumas tecnologias causam sensação de calor ou contração muscular durante a sessão, e a intensidade é ajustada para você.",
  },
  {
    p: "Em quanto tempo vejo diferença?",
    r: "Depende do protocolo e de cada organismo. Tratamentos que estimulam colágeno, por exemplo, têm efeito gradual, ao longo de semanas. Isso é explicado na avaliação.",
  },
  {
    p: "Quantas sessões vou precisar?",
    r: "O número de sessões é definido no seu protocolo, depois da avaliação. Ele depende da região, do objetivo e de como o seu corpo responde.",
  },
  {
    p: "Posso combinar tratamentos?",
    r: "Sim, quando faz sentido para o seu caso. Muitos protocolos da clínica unem técnicas para pele, sustentação e contorno, ou para gordura localizada e flacidez.",
  },
  {
    p: "Quem não pode fazer?",
    r: "Gestantes e pessoas com algumas condições de saúde não devem fazer certos tratamentos. Por isso a avaliação sempre vem antes de qualquer sessão.",
  },
  {
    p: "E se eu não morar em Santa Catarina?",
    r: "A clínica oferece consultoria online, por vídeo, com um protocolo de cuidados com a pele para fazer em casa. Os procedimentos continuam sendo feitos na clínica, depois de avaliação presencial.",
  },
  {
    p: "Quanto custa?",
    r: "O valor depende do protocolo definido na avaliação. Chame no WhatsApp para agendar e tirar essa dúvida diretamente com a clínica.",
  },
];
const { perguntas = padrao, titulo = "O que você", destaque = "costuma perguntar.", mensagem } = Astro.props;
---

<section class="secao nude" id="duvidas" aria-labelledby="t-duvidas">
  <div class="envolve grade">
    <div class="lado">
      <p class="chapeu">Dúvidas</p>
      <h2 class="titulo" id="t-duvidas">{titulo} <em>{destaque}</em></h2>
      <p class="abre">Ficou alguma dúvida? Pergunte no WhatsApp: a resposta vem da própria clínica.</p>
      <a class="botao linha" href={linkWhatsapp(mensagem)} target="_blank" rel="noopener">
        <Icone nome="whatsapp" tamanho={18} />
        Perguntar no WhatsApp
      </a>
    </div>
    <div class="lista">
      {
        perguntas.map(({ p, r }) => (
          <details>
            <summary>
              <h3>{p}</h3>
              <Icone nome="mais" tamanho={22} />
            </summary>
            <p>{r}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grade {
    display: grid;
    gap: 48px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .grade {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 88px;
    }
    .lado {
      position: sticky;
      top: 32px;
    }
  }
  .lado .botao {
    margin-top: 32px;
  }
  .lista {
    border-top: 1px solid var(--linha);
  }
  details {
    border-bottom: 1px solid var(--linha);
  }
  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 24px 0;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h3 {
    font-family: var(--serifa);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
  }
  summary :global(svg) {
    flex: none;
    color: var(--rose-texto);
    transition: rotate 0.25s ease;
  }
  details[open] summary :global(svg) {
    rotate: 45deg;
  }
  summary:hover h3 {
    color: var(--rose-texto);
  }
  details p {
    padding: 0 40px 26px 0;
    color: var(--tinta-2);
    max-width: 40em;
  }
  @media (prefers-reduced-motion: reduce) {
    summary :global(svg) {
      transition: none;
    }
  }
</style>
