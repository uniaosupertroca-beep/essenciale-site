---
// Abertura da home: clara, com título em serifa e um arco à direita. Com a foto
// src/assets/fotos/abertura.jpg, o arco mostra a foto; sem ela, mostra o monograma da marca.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { clinica, linkWhatsapp } from "../data/clinica.ts";
import type { NomeIcone } from "../data/icones.ts";
import Icone from "./Icone.astro";

const fotos = import.meta.glob<{ default: ImageMetadata }>("../assets/fotos/abertura.{jpg,jpeg,png,webp}", { eager: true });
const foto = Object.values(fotos)[0]?.default;

const selos: { icone: NomeIcone; texto: string }[] = [
  { icone: "brilho", texto: `${clinica.anos} anos de estética` },
  { icone: "prancheta", texto: "Protocolos personalizados" },
  { icone: "escudo", texto: "Sem cirurgia" },
  { icone: "estrela", texto: `Nota ${clinica.avaliacoes.nota} no Google` },
];
const giro = `Essenciale · ${clinica.anos} anos de estética · ${clinica.cidade} · `;
---

<section class="abertura" aria-labelledby="t-abertura">
  <div class="brilho" aria-hidden="true"></div>
  <div class="envolve grade">
    <div class="texto">
      <p class="chapeu">Clínica de estética em {clinica.cidade}</p>
      <h1 id="t-abertura">Ciência, técnica e arte <em>a favor da sua essência.</em></h1>
      <p class="apoio">
        Protocolos personalizados para rosto e corpo, sem cirurgia. Tudo começa por uma avaliação para entender você, a sua rotina e o que você
        deseja.
      </p>
      <div class="acoes">
        <a class="botao zap" href={linkWhatsapp()} target="_blank" rel="noopener">
          <Icone nome="whatsapp" tamanho={20} />
          Agendar avaliação
        </a>
        <a class="botao linha" href="/tratamentos/">Conhecer os tratamentos</a>
      </div>
      <ul class="selos">
        {
          selos.map((s) => (
            <li>
              <Icone nome={s.icone} tamanho={18} />
              {s.texto}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="arco-area">
      {
        foto ? (
          <figure class="arco">
            <Image
              src={foto}
              alt="Corredor em arco da Essenciale, com madeira clara e luz quente"
              widths={[440, 624]}
              sizes="(min-width: 960px) 440px, 90vw"
              loading="eager"
              decoding="async"
            />
          </figure>
        ) : (
          <div class="arco arte" aria-hidden="true">
            <span class="letra">E</span>
            <span class="faisca f1"><Icone nome="brilho" tamanho={22} traco={1.2} /></span>
            <span class="faisca f2"><Icone nome="brilho" tamanho={14} traco={1.3} /></span>
            <span class="nome">Essenciale</span>
          </div>
        )
      }
      <svg class="selo" viewBox="0 0 200 200" aria-hidden="true">
        <defs>
          <path id="circulo-abertura" d="M100 100m-78 0a78 78 0 1 1 156 0a78 78 0 1 1-156 0" />
        </defs>
        <circle cx="100" cy="100" r="99" class="fundo-selo" />
        <text><textPath href="#circulo-abertura" textLength="488">{giro}</textPath></text>
        <g class="centro-selo" transform="translate(84 84) scale(1.35)">
          <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" />
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .abertura {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--perola);
    padding: clamp(124px, 14vw, 168px) 0 clamp(72px, 9vw, 120px);
  }
  .brilho {
    position: absolute;
    inset: -10% -10% 0;
    z-index: -1;
    background:
      radial-gradient(38% 48% at 82% 34%, color-mix(in oklab, var(--rose) 34%, transparent), transparent 70%),
      radial-gradient(36% 40% at 4% 96%, color-mix(in oklab, var(--rose) 18%, transparent), transparent 70%),
      linear-gradient(180deg, var(--perola), var(--nude));
  }

  .grade {
    display: grid;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .grade {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 64px;
    }
  }

  h1 {
    margin-top: 24px;
    font-family: var(--serifa);
    font-size: clamp(46px, 7.2vw, 92px);
    line-height: 0.98;
    font-weight: 400;
    letter-spacing: -0.015em;
  }
  h1 em {
    display: block;
    font-weight: 500;
    color: var(--rose-texto);
  }
  .apoio {
    margin-top: 28px;
    max-width: 32em;
    font-size: clamp(17px, 1.6vw, 19px);
    font-weight: 300;
    color: var(--tinta-2);
  }
  .acoes {
    margin-top: 36px;
  }
  .selos {
    list-style: none;
    padding: 26px 0 0;
    margin-top: 40px;
    border-top: 1px solid var(--linha);
    display: flex;
    flex-wrap: wrap;
    gap: 12px 30px;
    font-size: 14.5px;
    color: var(--tinta-2);
  }
  .selos li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .selos :global(svg) {
    flex: none;
    color: var(--rose-texto);
  }

  /* Arco: a moldura da direita, com topo todo arredondado. */
  .arco-area {
    position: relative;
    justify-self: center;
    width: min(100%, 460px);
    padding: 0 0 36px 36px;
  }
  .arco {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px var(--raio) var(--raio);
    overflow: hidden;
    box-shadow: 0 40px 80px -48px color-mix(in oklab, var(--ameixa) 80%, transparent);
  }
  .arco::after {
    content: "";
    position: absolute;
    inset: 14px;
    border: 1px solid color-mix(in oklab, var(--rose-claro) 60%, transparent);
    border-radius: inherit;
    pointer-events: none;
  }
  .arco :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .arte {
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 50% at 50% 30%, color-mix(in oklab, var(--rose) 45%, transparent), transparent 75%),
      radial-gradient(80% 60% at 50% 100%, var(--ameixa-3), transparent 80%),
      var(--ameixa);
    color: var(--rose-claro);
  }
  .letra {
    font-family: var(--serifa);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(220px, 34vw, 340px);
    line-height: 1;
    translate: 0 -4%;
    color: transparent;
    -webkit-text-stroke: 1px var(--rose-claro);
    background: linear-gradient(180deg, color-mix(in oklab, var(--rose-claro) 40%, transparent), transparent 80%);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .faisca {
    position: absolute;
    color: var(--dourado);
  }
  .f1 {
    top: 24%;
    right: 22%;
  }
  .f2 {
    top: 36%;
    left: 22%;
  }
  .nome {
    position: absolute;
    bottom: 13%;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5em;
    margin-right: -0.5em;
    text-transform: uppercase;
    color: var(--rose-claro);
  }

  /* Selo que gira devagar no canto do arco. */
  .selo {
    position: absolute;
    left: 0;
    bottom: 0;
    width: clamp(118px, 13vw, 150px);
    height: auto;
    overflow: visible;
  }
  .fundo-selo {
    fill: var(--perola);
    stroke: color-mix(in oklab, var(--rose-texto) 30%, transparent);
  }
  .selo text {
    font-family: var(--fonte);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    fill: var(--rose-texto);
  }
  .centro-selo {
    fill: none;
    stroke: var(--rose-texto);
    stroke-width: 1.1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .selo text {
      transform-origin: 100px 100px;
      animation: gira 36s linear infinite;
    }
    .texto > * {
      animation: surge 0.9s cubic-bezier(0.2, 0.7, 0.1, 1) both;
    }
    .texto > :nth-child(2) {
      animation-delay: 0.08s;
    }
    .texto > :nth-child(n + 3) {
      animation-delay: 0.2s;
    }
    .arco-area {
      animation: surge 1.2s 0.15s cubic-bezier(0.2, 0.7, 0.1, 1) both;
    }
  }
  @keyframes gira {
    to {
      rotate: 1turn;
    }
  }
  @keyframes surge {
    from {
      opacity: 0;
      translate: 0 16px;
    }
  }
</style>
