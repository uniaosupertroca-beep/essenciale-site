---
// Marca tipográfica da Essenciale, em serifa. Quando o logo oficial chegar (src/assets/logo-essenciale.*),
// ele entra no lugar deste nome escrito.
interface Props {
  /** Tamanho do nome, em pixels. */
  tamanho?: number;
}
const { tamanho = 30 } = Astro.props;
---

<span class="marca" style={`--t: ${tamanho}px`}>
  <span class="nome">Essenciale</span>
  <span class="sub">Estética e Cosméticos</span>
</span>

<style>
  .marca {
    display: inline-grid;
    justify-items: center;
    line-height: 1;
  }
  .nome {
    font-family: var(--serifa);
    font-size: var(--t);
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .sub {
    margin-top: calc(var(--t) * 0.16);
    font-size: max(8.5px, calc(var(--t) * 0.29));
    font-weight: 500;
    letter-spacing: 0.32em;
    margin-right: -0.32em;
    text-transform: uppercase;
    opacity: 0.8;
  }
</style>
