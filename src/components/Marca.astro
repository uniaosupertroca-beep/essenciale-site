---
// Logo oficial da Essenciale (vetor do site atual da clínica): rosé sobre fundo claro, branco sobre fundo escuro.
interface Props {
  /** Altura do logo na tela, em pixels. */
  altura?: number;
  /** Versão branca, para fundo escuro. */
  claro?: boolean;
}
const { altura = 44, claro = false } = Astro.props;
const largura = Math.round(altura * (824.85 / 214.57));
---

<img
  class="marca"
  src={claro ? "/logo-essenciale-branco.svg" : "/logo-essenciale.svg"}
  alt="Essenciale Estética e Cosméticos"
  width={largura}
  height={altura}
  decoding="async"
/>

<style>
  .marca {
    display: block;
    width: auto;
    max-width: 100%;
  }
</style>
