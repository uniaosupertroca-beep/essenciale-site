---
// Quem idealizou a clínica, com o retrato e as frases que a Essenciale usa no site e no Instagram.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { clinica } from "../data/clinica.ts";
import type { NomeIcone } from "../data/icones.ts";
import Icone from "./Icone.astro";

const { idealizadora } = clinica;
const fotos = import.meta.glob<{ default: ImageMetadata }>("../assets/fotos/*.{jpg,jpeg,png,webp}", { eager: true });
const retrato = fotos[`../assets/fotos/${idealizadora.foto}`]?.default;
if (!retrato) throw new Error(`Foto não encontrada em src/assets/fotos/: ${idealizadora.foto}`);

const valores: { icone: NomeIcone; titulo: string; texto: string }[] = [
  {
    icone: "prancheta",
    titulo: "Método personalizado",
    texto: "Nenhum pacote pronto: cada protocolo nasce de uma avaliação do seu corpo, da sua rotina e do que você deseja.",
  },
  {
    icone: "camadas",
    titulo: "Técnicas que se somam",
    texto: "Tecnologia, técnica e cuidado com a pele trabalhando juntos, camada por camada.",
  },
  {
    icone: "coracao",
    titulo: "A sua identidade em primeiro lugar",
    texto: "Respeito à sua anatomia, à sua expressão e ao seu jeito. A ideia é valorizar, não transformar.",
  },
];
---

<section class="secao branca" id="essencia" aria-labelledby="t-essencia">
  <div class="envolve grade">
    <figure class="retrato">
      <Image
        src={retrato}
        alt={`${idealizadora.nome}, idealizadora da Essenciale, de camisa branca e braços cruzados`}
        widths={[420, 640, 840]}
        sizes="(min-width: 960px) 420px, 80vw"
        loading="lazy"
        decoding="async"
      />
      <figcaption>Desde {idealizadora.desde}</figcaption>
    </figure>
    <div class="texto">
      <p class="chapeu">Quem idealizou a Essenciale</p>
      <h2 class="titulo" id="t-essencia">{idealizadora.nome}</h2>
      <p class="abre">
        À frente da Essenciale desde {idealizadora.desde}, a Dra. Cláudia atua com tecnologias e protocolos para o rosto e o corpo, com foco na
        autoestima feminina e em um atendimento humanizado. Protocolos como o Pele de Rainha e o Bumbum das Estrelas nasceram desse trabalho.
      </p>
      <p class="lema">Rejuvenescer não é esticar a pele nem mudar quem você é: é revelar a sua melhor versão, com respeito à sua essência.</p>
      <ul class="valores">
        {
          valores.map((v) => (
            <li>
              <span class="icone">
                <Icone nome={v.icone} tamanho={22} traco={1.4} />
              </span>
              <div>
                <h3>{v.titulo}</h3>
                <p>{v.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .grade {
    display: grid;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .grade {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 88px;
    }
  }

  /* Retrato recortado sobre um arco rosé, a mesma forma da abertura. */
  .retrato {
    position: relative;
    justify-self: center;
    width: min(100%, 420px);
    aspect-ratio: 4 / 5;
    display: grid;
    align-items: end;
    border-radius: 999px 999px var(--raio) var(--raio);
    overflow: hidden;
    background:
      radial-gradient(70% 55% at 50% 22%, color-mix(in oklab, var(--rose-claro) 80%, transparent), transparent 75%),
      linear-gradient(180deg, var(--nude), color-mix(in oklab, var(--rose) 55%, var(--nude)));
  }
  .retrato::after {
    content: "";
    position: absolute;
    inset: 12px;
    border: 1px solid color-mix(in oklab, var(--branco) 70%, transparent);
    border-radius: inherit;
    pointer-events: none;
  }
  .retrato :global(img) {
    width: 92%;
    height: auto;
    margin-inline: auto;
  }
  figcaption {
    position: absolute;
    right: 22px;
    bottom: 22px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--ameixa);
    color: var(--rose-claro);
    font-family: var(--serifa);
    font-style: italic;
    font-size: 19px;
  }

  .lema {
    margin-top: 32px;
    padding-left: 22px;
    border-left: 1px solid var(--rose);
    font-family: var(--serifa);
    font-style: italic;
    font-size: clamp(22px, 2.4vw, 27px);
    line-height: 1.3;
    color: var(--rose-texto);
    max-width: 30em;
  }

  .valores {
    list-style: none;
    padding: 0;
    margin-top: 40px;
    display: grid;
    gap: 22px;
  }
  .valores li {
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }
  .icone {
    flex: none;
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--rose-texto) 35%, transparent);
    color: var(--rose-texto);
    background: var(--perola);
  }
  h3 {
    font-family: var(--serifa);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.15;
  }
  .valores p {
    margin-top: 4px;
    color: var(--tinta-2);
    font-size: 16px;
    max-width: 34em;
  }
</style>
