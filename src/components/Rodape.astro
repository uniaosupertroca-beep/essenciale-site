---
import { clinica, enderecoCompleto, linkWhatsapp, rotuloResponsavel, telefone } from "../data/clinica.ts";
import Marca from "./Marca.astro";

const r = clinica.responsavel;
const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="envolve">
    <div class="assinatura">
      <Marca tamanho={40} />
      <p>Clínica de estética em {clinica.cidade} ({clinica.uf}). Protocolos personalizados para rosto e corpo, sem cirurgia.</p>
    </div>
    <div>
      <h2>Contato</h2>
      <ul>
        <li><a href={linkWhatsapp()} target="_blank" rel="noopener">Agenda: WhatsApp {telefone()}</a></li>
        <li>
          <a href={linkWhatsapp(clinica.whatsapp.mensagem, clinica.whatsapp.atendimento)} target="_blank" rel="noopener"
            >Atendimento: WhatsApp {telefone(clinica.whatsapp.atendimento)}</a
          >
        </li>
        <li><a href={clinica.redes.instagram} target="_blank" rel="noopener">Instagram @essenciale</a></li>
      </ul>
    </div>
    <div>
      <h2>Clínica</h2>
      <ul>
        <li>{enderecoCompleto() ?? <>{clinica.cidade} ({clinica.uf}) · <span class="preencher">endereço</span></>}</li>
        <li>CNPJ {clinica.cnpj ?? <span class="preencher">CNPJ</span>}</li>
        <li>
          {rotuloResponsavel()}: {r.nome ?? <span class="preencher">nome</span>}, {r.profissao ?? <span class="preencher">profissão</span>}, {
            r.registro ?? <span class="preencher">registro no conselho</span>
          }
        </li>
      </ul>
    </div>
    <div class="fim">
      <span>© {ano} {clinica.nomeCompleto}. Todos os direitos reservados.</span>
      <a href="/privacidade/">Privacidade</a>
    </div>
  </div>
</footer>

<style>
  .rodape {
    background: #1f1115;
    color: var(--claro-2);
    padding-block: 72px 112px;
    font-size: 15px;
  }
  @media (min-width: 720px) {
    .rodape {
      padding-block: 88px 40px;
    }
  }
  .envolve {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 960px) {
    .envolve {
      grid-template-columns: 1.2fr 0.9fr 1.1fr;
      gap: 56px;
    }
  }
  .assinatura {
    display: grid;
    align-content: start;
    gap: 22px;
    justify-items: start;
    color: var(--claro);
  }
  .assinatura p {
    max-width: 24em;
    color: var(--claro-2);
  }
  h2 {
    margin-bottom: 16px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--rose);
  }
  ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  a {
    color: var(--claro);
    text-decoration: none;
  }
  a:hover {
    color: var(--rose-claro);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .preencher {
    color: var(--rose-claro);
    border-color: var(--rose);
  }
  .fim {
    grid-column: 1 / -1;
    padding-top: 24px;
    border-top: 1px solid color-mix(in oklab, var(--claro) 12%, transparent);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    font-size: 13.5px;
  }
</style>
